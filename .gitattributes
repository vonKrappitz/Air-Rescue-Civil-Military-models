# Auto detect text files and perform LF normalization
* text=auto

# Keep checksummed files byte-identical on every platform
*.py       text eol=lf
*.md       text eol=lf
*.cff      text eol=lf
*.txt      text eol=lf

# Data and figures: never normalised, excluded from language statistics
*.geojson  binary linguist-generated=true
*.png      binary
